generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoDisciplina {
  DEPORTE
  CULTURA
}

enum EstadoPostulacion {
  RECIBIDA
}

model Disciplina {
  id            String        @id @default(uuid()) @db.Uuid
  nombre        String        @unique
  tipo          TipoDisciplina
  descripcion   String
  cupoMaximo    Int           @default(0) @map("cupo_maximo")
  inscritos     Int           @default(0)
  publicada     Boolean       @default(true)
  horarios      Horario[]
  postulaciones Postulacion[]

  @@map("disciplinas")
}

model Horario {
  id           String     @id @default(uuid()) @db.Uuid
  disciplinaId String     @map("disciplina_id") @db.Uuid
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id])
  dia          Int
  inicio       DateTime   @db.Time(0)
  fin          DateTime   @db.Time(0)

  @@unique([disciplinaId, dia, inicio])
  @@map("horarios")
}

model Postulacion {
  id           String           @id @default(uuid()) @db.Uuid
  disciplinaId String           @map("disciplina_id") @db.Uuid
  disciplina   Disciplina       @relation(fields: [disciplinaId], references: [id])
  nombre       String           @db.VarChar(120)
  documento    String           @db.VarChar(40)
  correo       String           @map("correo_institucional") @db.VarChar(254)
  campus       String?          @db.VarChar(80)
  programa     String           @map("programa_academico") @db.VarChar(120)
  promedio     Decimal          @db.Decimal(3, 2)
  estado       EstadoPostulacion @default(RECIBIDA)
  creadaEn     DateTime         @default(now()) @map("creada_en") @db.Timestamptz(3)
  actualizadaEn DateTime        @updatedAt @map("actualizada_en") @db.Timestamptz(3)

  @@index([disciplinaId, estado])
  @@map("postulaciones")
}
